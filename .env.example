DATABASE_URL="postgresql://canopychain:canopychain@localhost:5432/canopychain"
PORT=3000
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
GFW_API_BASE_URL="https://data-api.globalforestwatch.org"
GFW_API_KEY=""
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Fill these in from canopychain-contracts/deployments.json once deployed.
PROJECT_REGISTRY_CONTRACT_ID=""
MILESTONE_VAULT_CONTRACT_ID=""

ATTESTOR_SECRET_KEY=""
INDEXER_POLL_INTERVAL_MS=5000

# How often (ms) the GFW polling worker checks each active project's
# polygon. Satellite layers don't refresh faster than this.
GFW_POLL_INTERVAL_MS=21600000

# Stellar public key (G...) that must sign requests to admin routes —
# should match the `admin` set on the deployed contracts.
ADMIN_ADDRESS=""

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Leave unset locally — set to "production" only in deployment, where it
# also switches logging from pino-pretty to structured JSON. The Docker
# image sets this itself; see ENVIRONMENT.md.
# NODE_ENV=production
