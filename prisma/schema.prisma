generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Donor {
  id        String           @id @default(uuid())
  address   String           @unique
  createdAt DateTime         @default(now()) @map("created_at")
  donations ProjectDonation[]

  @@map("donors")
}

model Project {
  id             String            @id @default(uuid())
  /// Project id shared by the project-registry and milestone-vault
  /// contracts — the same id names a project's registry entry and its
  /// pooled-donation vault.
  onChainId      BigInt            @unique @map("on_chain_id")
  operatorAddress String           @map("operator_address")
  /// `recipientAddress`, `attestorAddress`, and the polygon fields below
  /// are all null until the operator's project-registration intake
  /// (a later commit) attaches them to this row by `onChainId` — the
  /// on-chain `register` event carries only the project id, operator,
  /// and name, not the full project record.
  recipientAddress String?         @map("recipient_address")
  attestorAddress String?          @map("attestor_address")
  name           String
  /// The plot boundary as GeoJSON, queried against the Global Forest Watch
  /// API. `polygonHash` is the hex-encoded hash committed on-chain in
  /// project-registry so this polygon can't be swapped after donors fund
  /// the project — the backend is the source of truth for the shape, the
  /// chain is the source of truth for its hash.
  polygonGeoJson Json?             @map("polygon_geojson")
  polygonHash    String?           @map("polygon_hash")
  approved       Boolean           @default(false)
  cancelled      Boolean           @default(false)
  /// Consecutive GFW poll failures for this project's polygon, reset to 0
  /// on the next successful poll. Drives the backoff below so a project
  /// that can never succeed (malformed geometry, uncovered area) doesn't
  /// burn retry budget and API quota on every pass forever.
  gfwConsecutiveFailures Int       @default(0) @map("gfw_consecutive_failures")
  /// Set on failure to `now + backoff`; the poll worker skips this project
  /// until then instead of retrying it in full on every pass. Null means
  /// "poll normally" — either it's never failed, or it just succeeded.
  gfwNextPollAt  DateTime?         @map("gfw_next_poll_at")
  /// Set by an admin rejecting a not-yet-approved project — there's no
  /// on-chain "reject", only "approve", so a project an admin declines
  /// never gets an on-chain registry entry activated in the first place.
  reviewNote     String?           @map("review_note")
  /// i128 values mirrored from the milestone-vault contract, stored as
  /// decimal strings to avoid precision loss.
  totalDeposited String            @default("0") @map("total_deposited")
  totalReleased  String            @default("0") @map("total_released")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  milestones     Milestone[]
  donations      ProjectDonation[]
  snapshots      ForestCoverSnapshot[]

  @@map("projects")
}

enum MilestoneStatus {
  PENDING
  ATTESTED
}

model Milestone {
  id            String          @id @default(uuid())
  projectId     String          @map("project_id")
  project       Project         @relation(fields: [projectId], references: [id])
  /// Position of this tranche in the project's on-chain schedule (0-based).
  index         Int
  thresholdBps  Int             @map("threshold_bps")
  payoutBps     Int             @map("payout_bps")
  status        MilestoneStatus @default(PENDING)
  attestedAt    DateTime?       @map("attested_at")
  payoutAmount  String?         @map("payout_amount")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([projectId, index])
  @@map("milestones")
}

model ProjectDonation {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  donorId   String   @map("donor_id")
  donor     Donor    @relation(fields: [donorId], references: [id])
  /// i128 value from the contract, stored as a decimal string.
  amount    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, donorId])
  @@map("project_donations")
}

/// One Global Forest Watch check for a project's polygon. `changeBps` is
/// the cumulative forest-cover change since the project's baseline
/// snapshot, in basis points of plot area — the same unit milestone
/// thresholds are expressed in, so a snapshot can be compared to a
/// project's schedule directly.
model ForestCoverSnapshot {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id])
  checkedAt   DateTime @default(now()) @map("checked_at")
  forestCoverPct Float @map("forest_cover_pct")
  changeBps   Int      @map("change_bps")
  rawResponse Json?    @map("raw_response")

  @@index([projectId])
  @@map("forest_cover_snapshots")
}

/// Single-row-per-id table tracking how far the event indexer has gotten,
/// so a restart resumes instead of re-scanning from "now" every time.
model IndexerCheckpoint {
  id         String   @id
  lastLedger Int      @map("last_ledger")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("indexer_checkpoints")
}
